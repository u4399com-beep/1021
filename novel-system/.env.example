# Example .env — copy to .env and edit before `docker compose up`
# ------------------------------------------------------------------

# ─── Django ──────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-to-a-50-char-random-string
ALLOWED_HOSTS=*

# ─── Database ────────────────────────────────────────────────────
DB_NAME=novel
DB_USER=novel
DB_PASSWORD=change-me-in-env

# ─── Redis ─────────────────────────────────────────────────────
REDIS_PASSWORD=change-me-in-env

# ─── Crawler Engine: Tier-1 (Firecrawl) ──────────────────────────
# Get a key at https://firecrawl.dev — required to enable this tier.
# Leave empty to skip Firecrawl and fall back to httpx / Browser Use / Playwright.
FIRECRAWL_API_KEY=

# ─── Crawler Engine: Tier-2 (Browser Use, LLM-driven) ───────────
# Browser Use drives a real browser with an OpenAI-compatible LLM.
# Get a key at https://platform.openai.com (or use any OpenAI-compatible endpoint).
# Optional: BROWSER_USE_MODEL defaults to gpt-4o-mini.
BROWSER_USE_OPENAI_API_KEY=
OPENAI_API_KEY=
BROWSER_USE_MODEL=gpt-4o-mini

# ─── Crawler Engine: Tier-3 (Playwright + Hyperbrowser) ─────────
# Playwright runs locally (always available). Hyperbrowser adds residential
# IPs and real fingerprints via a hosted browser pool — get a key at
# https://hyperbrowser.ai. Leave empty to use local Playwright only.
HYPERBROWSER_API_KEY=
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_PROXY=
