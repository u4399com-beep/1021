# Example .env — copy to .env and edit before `docker compose up`
# ------------------------------------------------------------------

# Django
DJANGO_SECRET_KEY=change-me-to-a-50-char-random-string
ALLOWED_HOSTS=*

# Database
DB_NAME=novel
DB_USER=novel
DB_PASSWORD=novel_pwd_2024

# Crawler engine — optional API keys (leave empty to skip that tier)
FIRECRAWL_API_KEY=
BROWSER_USE_OPENAI_API_KEY=
HYPERBROWSER_API_KEY=
OPENAI_API_KEY=

# Playwright
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_PROXY=
